# --- Claude ---
ANTHROPIC_API_KEY=
# Opcional: modelo y nivel de esfuerzo (low | medium | high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=                 # token de acceso permanente (System User)
WHATSAPP_PHONE_NUMBER_ID=       # ID del número de teléfono (no el número)
WHATSAPP_VERIFY_TOKEN=          # texto que tú inventas; se pone igual en Meta al configurar el webhook
WHATSAPP_APP_SECRET=            # "App Secret" de tu app de Meta (valida la firma de los webhooks)
WHATSAPP_GRAPH_VERSION=v23.0

# --- Google Calendar ---
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# En un hosting donde no puedes subir archivos, pega aquí el contenido de la clave
# (el JSON completo o ese JSON en base64). Si está definida, se usa en lugar del archivo.
# GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=             # normalmente tu correo de Gmail, o el ID del calendario

# --- Negocio ---
BUSINESS_CONFIG=business.yaml
OWNER_WHATSAPP=                 # opcional: tu número (formato 5215512345678) para avisos de "quiero hablar con una persona"
DATABASE_PATH=data/agent.db
